# Server-only Google Places API (New) key. Enable Places API in Google Cloud.
GOOGLE_PLACES_API_KEY=
# Optional: exact Place ID for Autotronica Godiag. If absent, the server resolves
# the business by name and confirms coordinates from the supplied Maps profile.
GOOGLE_PLACE_ID=

# Preferred integration: all existing and new reviews via owner-authorized GBP API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
# accounts/ACCOUNT_ID/locations/LOCATION_ID (not the public Maps Place ID)
GOOGLE_BUSINESS_LOCATION=
